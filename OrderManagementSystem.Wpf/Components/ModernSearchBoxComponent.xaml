<UserControl x:Class="OrderManagementSystem.Wpf.Components.ModernSearchBoxComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" 
             x:Name="SearchBoxRoot">

    <Grid>
        
        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                 Tag="{Binding Placeholder, ElementName=SearchBoxRoot}"
                 Text="{Binding SearchText, ElementName=SearchBoxRoot, UpdateSourceTrigger=PropertyChanged}"
                 Padding="10,0,35,0"/>

        <TextBlock Text="🔍"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,12,0"
                   IsHitTestVisible="False"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        
    </Grid>
    
</UserControl>
