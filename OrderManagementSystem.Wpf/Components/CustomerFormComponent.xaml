<UserControl x:Class="OrderManagementSystem.Wpf.Components.CustomerFormComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Components"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}" Width="1000">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="#FEE2E2"
                CornerRadius="8"
                Margin="0,0,0,25"
                Padding="15,12"
                Visibility="{Binding ErrorMessage,
                Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,8" 
                       RenderTransformOrigin="0.5,0.5" Height="16" Width="958">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="0.017"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                     Tag="e.g. Khazaal Emad Khazaal"
                     Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Width="962"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Email Address" FontWeight="SemiBold" Margin="0,0,0,8" Height="15" Width="950"/>
            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                     Tag="example@domain.com"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="960"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="Physical Address" FontWeight="SemiBold" Width="939" Height="21"/>
            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                     Tag="City, Street, Building No."
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     Height="80" 
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" Width="960"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,25">
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Phone Contacts Management" FontWeight="Bold" 
                           FontSize="16" VerticalAlignment="Center" Margin="24,0,596,0"/>
                <Button Content="+ Add Number"
                        Command="{Binding AddPhoneCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource OutlineButtonStyle}"
                        Padding="10,4"
                        FontSize="12" Margin="0,2,23,-2"/>
            </Grid>

            <Border Background="#F8FAFC" CornerRadius="8" Padding="15" 
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Width="973">
                <ItemsControl ItemsSource="{Binding CustomerPhones}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="White" CornerRadius="6" BorderThickness="1" 
                                        BorderBrush="{StaticResource BorderBrush}" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="📞" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                   Margin="12,0,0,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   Panel.ZIndex="1"/>
                                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="38,10,10,10" VerticalContentAlignment="Center"
                                                 Background="Transparent" BorderThickness="0" 
                                                 Tag="Phone Number..."/>
                                    </Grid>
                                </Border>

                                <ComboBox Grid.Column="1" SelectedValue="{Binding PhoneType, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          Margin="0,0,10,0" Height="42" 
                                          VerticalContentAlignment="Center" Padding="10,0">
                                    <ComboBoxItem Content="Mobile"/>
                                    <ComboBoxItem Content="Work"/>
                                    <ComboBoxItem Content="Home"/>
                                </ComboBox>

                                <CheckBox Grid.Column="2" 
                                          Command="{Binding DataContext.SetPrimaryCommand, 
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"
                                          IsChecked="{Binding IsPrimary, UpdateSourceTrigger=PropertyChanged}" 
                                          Content="Primary ⭐" 
                                          Style="{StaticResource ModernToggleSwitch}"
                                          VerticalAlignment="Center" Margin="10,0"/>

                                <Button Grid.Column="3" 
                                        Command="{Binding DataContext.RemovePhoneCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#FEE2E2" BorderThickness="0" 
                                        Width="40" Height="40" Cursor="Hand" Margin="0,0,5,0">
                                    <TextBlock Text="🗑️" Foreground="#B91C1C" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>

                                <Button Grid.Column="4"
                                        Command="{Binding DataContext.UpdatePhoneCommand, 
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#DCFCE7" BorderThickness="0" 
                                        Width="40" Height="40" Cursor="Hand"
                                        Visibility="{Binding DataContext.UpdatePhoneCommand, 
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}, 
                                        Converter={StaticResource BoolToVisibilityConverter}, 
                                        FallbackValue=Collapsed}">
                                    <TextBlock Text="💾" VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
