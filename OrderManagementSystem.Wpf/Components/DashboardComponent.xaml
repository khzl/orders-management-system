<UserControl x:Class="OrderManagementSystem.Wpf.Components.DashboardComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Components"
             xmlns:components="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="10">
            
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="Dashboard Overview"
                           Style="{StaticResource TextHeading1}"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Manage and Monitor Your Shop`s Performance in Real-Time...."
                           Style="{StaticResource TextMuted}"/>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,30">
                <components:CardComponent Title="Total Revenue" Value="12,840$" Margin="0,0,15,0"/>
                <components:CardComponent Title="Active Orders" Value="42" Margin="0,0,15,0"/>
                <components:CardComponent Title="New Customers" Value="128" Margin="0,0,15,0"/>
                <components:CardComponent Title="Pending Shipments" Value="7" Margin="0,0,0,0"/>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Recent Orders"
                                   Style="{StaticResource TextHeading2}"
                                   VerticalAlignment="Center"/>
                        <Button Content="View All Orders"
                                Style="{StaticResource OutlineButtonStyle}"
                                HorizontalAlignment="Right"
                                Padding="15,5"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}"/>

                    <DataGrid Style="{StaticResource ModernDataGridStyle}"
                              ItemsSource="{Binding RecentOrders}"
                              Margin="0"
                              MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="100"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding OrderDate}" Width="150"/>
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount}" Width="120"/>

                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#DCFCE7" CornerRadius="12"
                                                Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="#166534"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Details"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
