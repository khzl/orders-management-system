<UserControl x:Class="OrderManagementSystem.Wpf.Components.CustomDialogViewComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Components"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             mc:Ignorable="d" Height="210" Background="Transparent" Width="500"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ActionToTextConverter x:Key="ActionToTextConverter"/>
    </UserControl.Resources>
    
    <Border Background="White" CornerRadius="12"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" 
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15"/>
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="#FEF2F2" Width="48" Height="48" CornerRadius="14">
                    <TextBlock Text="⚠️" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}" 
                           Style="{StaticResource TextHeading2}" 
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding Message}"
                       Style="{StaticResource TextMuted}" 
                       TextWrapping="Wrap" FontSize="15" Margin="0,0,0,30"
                       LineHeight="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsConfirmation,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="110" Height="42" Margin="0,0,12,0"/>
                <Button Content="{Binding IsConfirmation,
                                   Converter={StaticResource ActionToTextConverter}}"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="140" Height="42"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
