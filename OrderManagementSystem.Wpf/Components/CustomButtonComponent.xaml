<UserControl x:Class="OrderManagementSystem.Wpf.Components.CustomButtonComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="150">

    <Button Style="{StaticResource BaseButtonStyle}"
            x:Name="btnMain"
            HorizontalContentAlignment="Stretch">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="txtIcon"
                       Text="+"
                       FontSize="16"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Visibility="Visible"/>

            <TextBlock x:Name="txtText"
                       Text="Add"
                       VerticalAlignment="Center"/>
        </StackPanel>
        
    </Button>
    
</UserControl>
