<UserControl x:Class="OrderManagementSystem.Wpf.Components.AlertNotificationComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             x:Name="AlertRoot">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="#FEE2E2" CornerRadius="6" Padding="15,10"
            Visibility="{Binding Message , ElementName=AlertRoot,
             Converter={StaticResource StringToVisibilityConverter}}">

        <StackPanel Orientation="Horizontal">

            <TextBlock Text="⚠️" Margin="0,0,10,0" VerticalAlignment="Center"/>

            <TextBlock Text="{Binding Message , ElementName=AlertRoot}"
                       Foreground="#B91C1C"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            
        </StackPanel>
        
    </Border>
    
</UserControl>
