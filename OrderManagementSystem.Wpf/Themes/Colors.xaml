<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                     COLOR DESIGN TOKENS                         ║
    ║                                                                  ║
    ║  WHY TWO LAYERS, NOT THREE:                                     ║
    ║  {StaticResource} is a markup extension — it is only valid as   ║
    ║  an XML *attribute* value, not as <Color> element inner text.   ║
    ║  <Color> uses a TypeConverter that expects a raw hex string.    ║
    ║  Semantic naming therefore lives on the Brush keys, which       ║
    ║  reference base-palette Colors via the valid attribute form.    ║
    ║                                                                  ║
    ║  Structure:                                                      ║
    ║    1. Base Palette          — <Color> with hex values only      ║
    ║    2. Semantic Brushes      — <SolidColorBrush                  ║
    ║                                  Color="{StaticResource XxxYY}" ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ════════════════════════════════════════════════════════════════
         1. BASE PALETTE  —  <Color> entries, hex values ONLY.
         {StaticResource} is NOT valid here; Color uses a TypeConverter
         that only accepts raw hex strings as element content.
         Controls and styles must NOT reference these keys directly —
         use the semantic brush keys in Section 2 instead.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Primary — Blue -->
    <Color x:Key="Blue100">#DBEAFE</Color>
    <Color x:Key="Blue500">#3B82F6</Color>
    <Color x:Key="Blue600">#2563EB</Color>
    <Color x:Key="Blue700">#1D4ED8</Color>
    <Color x:Key="Blue800">#1E40AF</Color>

    <!-- Slate — Neutrals (text, borders, surfaces) -->
    <Color x:Key="Slate50">#F8FAFC</Color>
    <Color x:Key="Slate100">#F1F5F9</Color>
    <Color x:Key="Slate200">#E2E8F0</Color>
    <Color x:Key="Slate300">#CBD5E1</Color>
    <Color x:Key="Slate400">#94A3B8</Color>
    <Color x:Key="Slate500">#64748B</Color>
    <Color x:Key="Slate700">#334155</Color>
    <Color x:Key="Slate800">#1E293B</Color>
    <Color x:Key="Slate900">#0F172A</Color>

    <!-- Green — Success -->
    <Color x:Key="Green100">#D1FAE5</Color>
    <Color x:Key="Green300">#6EE7B7</Color>
    <Color x:Key="Green500">#22C55E</Color>
    <Color x:Key="Green600">#16A34A</Color>
    <Color x:Key="Green900">#065F46</Color>

    <!-- Red — Danger -->
    <Color x:Key="Red100">#FEE2E2</Color>
    <Color x:Key="Red300">#FCA5A5</Color>
    <Color x:Key="Red500">#EF4444</Color>
    <Color x:Key="Red700">#B91C1C</Color>
    <Color x:Key="Red800">#991B1B</Color>

    <!-- Amber — Warning (fixed: was #F59E08, correct amber-500 is #F59E0B) -->
    <Color x:Key="Amber100">#FEF3C7</Color>
    <Color x:Key="Amber200">#FDE68A</Color>
    <Color x:Key="Amber500">#F59E0B</Color>
    <Color x:Key="Amber600">#D97706</Color>
    <Color x:Key="Amber900">#78350F</Color>

    <!-- Sky — Info -->
    <Color x:Key="Sky100">#E0F2FE</Color>
    <Color x:Key="Sky300">#7DD3FC</Color>
    <Color x:Key="Sky500">#0EA5E9</Color>
    <Color x:Key="Sky600">#0284C7</Color>
    <Color x:Key="Sky900">#075985</Color>

    <!-- Overlay (semi-transparent black for loading backdrops) -->
    <Color x:Key="OverlayColor">#80000000</Color>

    <!-- White / Transparent -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="TransparentColor">#00FFFFFF</Color>

    
    <!-- ════════════════════════════════════════════════════════════════
         2. SEMANTIC BRUSHES
         Naming: role describes intent, not color.
         The Color attribute uses {StaticResource} against base-palette
         Color keys — this is the ATTRIBUTE form, which IS valid.
         Controls and styles must only reference keys from this section.
    ═══════════════════════════════════════════════════════════════════ -->
    
    <!-- ── Brand / Primary ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryBrush"       Color="{StaticResource Blue600}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"   Color="{StaticResource Blue800}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"  Color="{StaticResource Blue100}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"  Color="{StaticResource Blue700}"/>

    <!-- ── Secondary ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SecondaryBrush"     Color="{StaticResource Slate500}"/>

    <!-- ── Surface &amp; Layout ────────────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource Slate50}"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource White}"/>
    <!-- Card face  -->
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="{StaticResource Slate100}"/>
    <!-- Row hover  -->
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource Slate200}"/>
    <SolidColorBrush x:Key="BorderFocusBrush"   Color="{StaticResource Blue500}"/>
    <SolidColorBrush x:Key="CardShadowBrush"    Color="{StaticResource Slate900}"/>
    <!-- Dark navy, not brown -->
    <SolidColorBrush x:Key="OverlayBrush"       Color="{StaticResource OverlayColor}"/>
    <!-- #80000000 50% black  -->
    <SolidColorBrush x:Key="TransparentBrush"   Color="{StaticResource TransparentColor}"/>

    <!-- ── Text ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource Slate800}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Slate500}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource Slate400}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource Slate300}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource White}"/>

    <!-- ── Success ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessBrush"           Color="{StaticResource Green500}"/>
    <SolidColorBrush x:Key="SuccessDarkBrush"       Color="{StaticResource Green600}"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource Green100}"/>
    <SolidColorBrush x:Key="SuccessBorderBrush"     Color="{StaticResource Green300}"/>
    <SolidColorBrush x:Key="SuccessTextBrush"       Color="{StaticResource Green900}"/>

    <!-- ── Danger ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="DangerBrush"            Color="{StaticResource Red500}"/>
    <SolidColorBrush x:Key="DangerDarkBrush"        Color="{StaticResource Red700}"/>
    <SolidColorBrush x:Key="DangerBackgroundBrush"  Color="{StaticResource Red100}"/>
    <!-- pale tint, not full red -->
    <SolidColorBrush x:Key="DangerBorderBrush"      Color="{StaticResource Red300}"/>
    <!-- mid-tone, not full red  -->
    <SolidColorBrush x:Key="DangerTextBrush"        Color="{StaticResource Red800}"/>
    <!-- dark, readable          -->

    <!-- ── Warning ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WarningBrush"           Color="{StaticResource Amber500}"/>
    <SolidColorBrush x:Key="WarningDarkBrush"       Color="{StaticResource Amber600}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource Amber100}"/>
    <SolidColorBrush x:Key="WarningBorderBrush"     Color="{StaticResource Amber200}"/>
    <SolidColorBrush x:Key="WarningTextBrush"       Color="{StaticResource Amber900}"/>

    <!-- ── Info ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="InfoBrush"              Color="{StaticResource Sky500}"/>
    <SolidColorBrush x:Key="InfoDarkBrush"          Color="{StaticResource Sky600}"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush"    Color="{StaticResource Sky100}"/>
    <SolidColorBrush x:Key="InfoBorderBrush"        Color="{StaticResource Sky300}"/>
    <SolidColorBrush x:Key="InfoTextBrush"          Color="{StaticResource Sky900}"/>

</ResourceDictionary>