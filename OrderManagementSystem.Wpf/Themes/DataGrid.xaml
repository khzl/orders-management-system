<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║  DATAGRID STYLES                                                 ║
    ║                                                                  ║
    ║  Dependency: ControlStyles.xaml must be merged first —          ║
    ║  ModernScrollBar is referenced from Style.Resources here.       ║
    ║                                                                  ║
    ║  Contents:                                                       ║
    ║    ModernDataGridStyle   — DataGrid root                        ║
    ║    DataGridCell          — implicit (all cells)                 ║
    ║    DataGridColumnHeader  — implicit (all headers) + sort arrows ║
    ║    DataGridRow           — implicit (all rows) + state triggers  ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ModernDataGridStyle -->
    <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background"                    Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderThickness"               Value="1"/>
        <Setter Property="BorderBrush"                   Value="{DynamicResource BorderBrush}"/>
        <Setter Property="RowBackground"                 Value="{DynamicResource SurfaceBrush}"/>
        <!-- AlternatingRowBackground #F8FAFC = Slate50 = BackgroundBrush (exact) -->
        <Setter Property="AlternatingRowBackground"      Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="GridLinesVisibility"           Value="None"/>
        <Setter Property="AutoGenerateColumns"           Value="False"/>
        <Setter Property="CanUserAddRows"                Value="False"/>
        <Setter Property="CanUserResizeRows"             Value="False"/>
        <Setter Property="CanUserReorderColumns"         Value="False"/>
        <Setter Property="SelectionMode"                 Value="Single"/>
        <!-- FullRow: clicking any cell in a row selects the whole row -->
        <Setter Property="SelectionUnit"                 Value="FullRow"/>
        <Setter Property="FontSize"                      Value="13"/>
        <Setter Property="ColumnHeaderHeight"            Value="45"/>
        <Setter Property="RowHeight"                     Value="55"/>
        <Setter Property="HeadersVisibility"             Value="Column"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        <!-- Virtualizes rows that are off-screen — essential for performance -->
        <Setter Property="EnableRowVirtualization"       Value="True"/>
        <Setter Property="FocusVisualStyle"              Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels"           Value="True"/>
        <Style.Resources>
            <!-- Scopes ModernScrollBar to this DataGrid only -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
        </Style.Resources>
    </Style>


    <!-- Data Grid Cell Styles -->
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="cellBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!--
                            Selected: transparent cell background so the
                            row-level highlight (from DataGridRow) shows through.
                            Foreground shifts to primary dark for contrast.
                        -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="cellBorder" Property="Background"
                                    Value="Transparent"/>
                            <!-- FIX: was hardcoded #1D4ED8 = Blue700 = PrimaryHoverBrush -->
                            <Setter Property="Foreground"
                                    Value="{DynamicResource PrimaryHoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="cellBorder" Property="Background"
                                    Value="Transparent"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- DataGridColumnHeader Style -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"          Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="FontSize"            Value="12"/>
        <Setter Property="Padding"             Value="15,0"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="SeparatorBrush"      Value="{DynamicResource BorderBrush}"/>
        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border x:Name="headerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>

                            <!--
                                Sort arrow — hidden by default.
                                Data path swaps between ascending (↑) and descending (↓)
                                via SortDirection triggers below.
                            -->
                            <Path x:Name="sortArrow"
                                  Grid.Column="1"
                                  Visibility="Collapsed"
                                  Margin="4,0,12,0"
                                  Width="8" Height="6"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Data="M0,6 L4,0 L8,6 Z"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover: slightly darker header to signal it is clickable -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="headerBorder" Property="Background"
                                    Value="{DynamicResource BorderBrush}"/>
                        </Trigger>

                        <!-- Sort ascending (↑ arrow) -->
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="sortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sortArrow" Property="Data"       Value="M0,6 L4,0 L8,6 Z"/>
                        </Trigger>

                        <!-- Sort descending (↓ arrow) -->
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="sortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sortArrow" Property="Data"       Value="M0,0 L4,6 L8,0 Z"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGridRow Style -->
    <Style TargetType="DataGridRow">
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Margin"           Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="rowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource SurfaceHoverBrush}"
                            BorderThickness="0,0,0,1">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </SelectiveScrollingGrid.RowDefinitions>

                            <!--
                                Row header — hidden when HeadersVisibility="Column"
                                on the parent DataGrid, but required in the template
                                for the SelectiveScrollingGrid layout to be correct.
                            -->
                            <DataGridRowHeader
                                Grid.Column="0" Grid.Row="0"
                                SelectiveScrollingGrid.SelectiveScrollingOrientation="None"/>

                            <!-- Cell content -->
                            <DataGridCellsPresenter
                                Grid.Column="1" Grid.Row="0"
                                SelectiveScrollingGrid.SelectiveScrollingOrientation="Horizontal"/>

                            <!--
                                Row details panel — collapsed by default.
                                Becomes visible when DataGrid.RowDetailsTemplate is set.
                            -->
                            <DataGridDetailsPresenter
                                Grid.Column="1" Grid.Row="1"
                                SelectiveScrollingGrid.SelectiveScrollingOrientation="Horizontal"/>
                        </SelectiveScrollingGrid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover: neutral surface tint -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="rowBorder" Property="Background"
                                    Value="{DynamicResource SurfaceHoverBrush}"/>
                        </Trigger>

                        <!-- Selected: primary light tint + matching bottom border -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="rowBorder" Property="Background"
                                    Value="{DynamicResource PrimaryLightBrush}"/>
                            <Setter TargetName="rowBorder" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryLightBrush}"/>
                        </Trigger>

                        <!--
                            Selected + hovered: keep the selection highlight dominant.
                            Without this, the IsMouseOver trigger fires after IsSelected
                            and overwrites the selection background.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"  Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="rowBorder" Property="Background"
                                    Value="{DynamicResource PrimaryLightBrush}"/>
                            <Setter TargetName="rowBorder" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryLightBrush}"/>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>