<Application x:Class="OrderManagementSystem.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             >
       <!--StartupUri="MainWindow.xaml"-->
    <Application.Resources>
        
        <!-- Wrap everything in a ResourceDictionary (owner of MergedDictionaries) -->
        <ResourceDictionary>
            
            <!-- Here Add Themes in This Resources -->
            <ResourceDictionary.MergedDictionaries>
                <!-- Here Add Themes -->
                <ResourceDictionary Source="/Themes/Buttons.xaml"/>
                <ResourceDictionary Source="/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
                <ResourceDictionary Source="/Themes/DataGrid.xaml"/>
                <ResourceDictionary Source="/Themes/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
        
    </Application.Resources>
</Application>
