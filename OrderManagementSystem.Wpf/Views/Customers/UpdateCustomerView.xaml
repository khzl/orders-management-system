<UserControl x:Class="OrderManagementSystem.Wpf.Views.Customers.UpdateCustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Views.Customers"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             xmlns:components="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}" Height="737">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal" 
                                Margin="0,0,0,10">
                        <Button Command="{Binding CancelCommand}" 
                                IsEnabled="{Binding IsLoading, 
                                Converter={StaticResource InverseBoolConverter}}" 
                                Style="{StaticResource OutlineButtonStyle}" 
                                Content="←" FontSize="18" 
                                Padding="10,0" Margin="0,0,15,0"/>
                        <TextBlock Text="Update Customer" 
                                   Style="{StaticResource TextHeading1}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Modify customer details and phone contacts information." 
                               Style="{StaticResource TextMuted}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" 
                        MaxWidth="1400" HorizontalAlignment="Stretch" Padding="30">
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" 
                                      VerticalScrollBarVisibility="Auto">
                            <components:CustomerFormComponent 
                                Margin="11,0,0,30"
                                                              CustomerName="{Binding CustomerName}"
                                                              Email="{Binding Email}"
                                                              Address="{Binding Address}"
                                                              ErrorMessage="{Binding ErrorMessage}"
                                                              IsLoading="{Binding IsLoading}"
                                                              CustomerPhones="{Binding CustomerPhones}"
                                                              AddPhoneCommand="{Binding AddPhoneCommand}"
                                                              RemovePhoneCommand="{Binding RemovePhoneCommand}"
                                                              UpdatePhoneCommand="{Binding UpdatePhoneCommand}"
                                                              SetPrimaryCommand="{Binding SetPrimaryCommand}"/>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancel" 
                                    Command="{Binding CancelCommand}" 
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" 
                                    Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0" Height="45"/>
                            <Button Grid.Column="1" Content="Update Changes" Command="{Binding SaveCommand}" 
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" 
                                    Style="{StaticResource SuccessButtonStyle}" Height="45"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
