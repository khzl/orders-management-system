<UserControl x:Class="OrderManagementSystem.Wpf.Views.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Views.Customers"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             xmlns:components="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <converters:NumericToVisibilityConverter x:Key="NumericToVisibilityConverter"/>
    </UserControl.Resources>

    <!--
    Root Grid - two layers 
    [0] Page Content (3 rows)
    [1] loading overlay (Rowspan = 3, ZIndex = 100)
    -->
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- page header -->
            <RowDefinition Height="Auto"/>
            <!-- toolbar + search -->
            <RowDefinition Height="*"/>
            <!-- DataGrid + pagination -->
        </Grid.RowDefinitions>

        <!-- Row 0 - Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            
            <TextBlock Text="Customers"
                       Style="{StaticResource TextHeading1}"/>
            <TextBlock Text="Manage your customer database and search through their records efficiently."
                       Style="{StaticResource TextMuted}"
                       Margin="0,4,0,0"/>

            <components:AlertNotificationComponent 
                Message="{Binding ErrorMessage}" 
                Margin="0,12,0,0"/>
            
        </StackPanel>

        <!-- Row 1 - Toolbar (action button + search) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Star Size -->
                <ColumnDefinition Width="Auto"/>
                <!-- Auto Size -->
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                
                <Button Content="+ Add New Customer"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource SuccessButtonStyle}"
                        Height="38" Padding="16,0"/>

                <Button Content="↻ Refresh"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Height="38" Width="110" 
                        Margin="8,0,0,0"/>
                
                <!-- Delete All Customers-->
                <Button Command="{Binding DeleteAllCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Height="38" Padding="14,0" 
                        Margin="8,0,0,0">
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete All" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- search controls -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Search By:" 
                           Style="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <ComboBox ItemsSource="{Binding SearchTypes}"
                          SelectedItem="{Binding SelectedSearchType, Mode=TwoWay}"
                          Width="150" Height="36">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='Search by {0}'}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Keyword:" 
                           Style="{StaticResource TextMuted}"
                           VerticalAlignment="Center" 
                           Margin="16,0,8,0"/>

                <components:ModernSearchBoxComponent 
                    SearchText="{Binding SearchText , Mode=TwoWay}"
                    Placeholder="Type To Search......."
                    Width="280"/>

            </StackPanel>
        </Grid>

        <!-- Row 2 - DataGrid + Pagination -->
        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- For Data Grid Card  -->
                <RowDefinition Height="Auto"/>
                <!-- For Pagination Card -->
            </Grid.RowDefinitions>

            <!-- DataGrid Card -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,60"
                                Visibility="{Binding Customers.Count,
                                Converter={StaticResource ZeroToVisibilityConverter}}">
                        
                        <TextBlock Text="👥"
                                   FontSize="52"
                                   HorizontalAlignment="Center"
                                   Opacity="0.35"/>
                        
                        <TextBlock Text="No customers found"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,14,0,6"/>
                        
                        <TextBlock Text="Add a new customer or adjust your search filter."
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource TextMuted}"/>

                    </StackPanel>
                    
                    <DataGrid ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer , Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      RowHeight="65"
                      RowDetailsVisibilityMode="Collapsed"
                      ScrollViewer.CanContentScroll="False"
                      Visibility="{Binding Customers.Count,
                        Converter={StaticResource NumericToVisibilityConverter}}">

                        <!-- RowStyle -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="DetailsVisibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        
                        <!-- ==== Columns Here ======== -->
                        <DataGrid.Columns>
                            
                            <!-- # ID -->
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding CustomerId}"
                                                Width="0.6" MinWidth="80"/>
                            
                            <!-- Customer Info -> CustomerName + Email Column -->
                            <DataGridTemplateColumn Header="Customer Info"
                                            Width="2*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding CustomerName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Email}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Phone Contacts : navigate button + count badge  -->
                            <DataGridTemplateColumn Header="Phone Contacts" 
                                                    Width="1.5*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.NavigateToPhonesCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Padding="10,4" Height="36"
                                            Margin="10,0"
                                            HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📱"
                                                           FontSize="14"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="Manage Numbers"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                                <Border Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="10"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Phones.Count}"
                                                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <!-- Location / Address  -->
                            <DataGridTemplateColumn Header="Location Address"
                                            Width="1.5*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Address}"
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Style="{StaticResource TextBody}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column For Delete And Update Customers -->
                            <DataGridTemplateColumn Header="Actions" Width="1.5*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0">
                                            
                                            <!-- Edit -->
                                            <Button Command="{Binding DataContext.EditCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource OutlineButtonStyle}"
                                                    Height="34"
                                                    Padding="10,2" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✏️" FontSize="13" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Edit" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Delete Current Row Only -->
                                            <Button Command="{Binding DataContext.DeleteCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Height="34"
                                                    Padding="10,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️" FontSize="13" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Delete" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Add Column Toggle Professional -->
                            <DataGridTemplateColumn Header="Row Details" 
                                                Width="0.8*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="ExpanderBtn"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Style="{StaticResource GhostToggleButtonStyle}"
                                                      Width="32" Height="32"
                                                      HorizontalAlignment="Center"
                                                      ToolTip="Show / Hide Contact Details">
                                            <!-- Rotates 90 Dgree -->
                                            <ToggleButton.RenderTransform>
                                                <RotateTransform Angle="0" CenterX="16" CenterY="16"/>
                                            </ToggleButton.RenderTransform>
                                            <TextBlock Text="›"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </ToggleButton>
                                        
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ExpanderBtn" Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ExpanderBtn" 
                                                                             Storyboard.TargetProperty=
                                                              "(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="90" 
                                                                             Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ExpanderBtn" 
                                                                             Storyboard.TargetProperty=
                                                               "(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="0" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                        <!-- Here Row Details Template in Data Grid -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceHoverBrush}"  
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,1"
                                        Padding="20,14">
                                    <StackPanel>
                                        
                                        <TextBlock Text="All Contact Numbers" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Margin="0,0,0,10" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Phones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" 
                                                                Margin="0,0,0,6">
                                                        <Border Background="{DynamicResource BorderBrush}" 
                                                                Padding="8,3" 
                                                                CornerRadius="4">
                                                            <TextBlock Text="{Binding PhoneType}" 
                                                                       FontSize="10" 
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding PhoneNumber}" 
                                                                   Margin="10,0,0,0" 
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Background="{DynamicResource InfoBackgroundBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsPrimary,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Primary ★"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource InfoDarkBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Pagination Card -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,10,0,0"
                    Padding="4,6">
                <components:PaginationComponent
                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                    TotalPages="{Binding TotalPages}"
                    HorizontalAlignment="Stretch"
                    Margin="6"/>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="100"
              Visibility="{Binding IsLoading,
              Converter={StaticResource BoolToVisibilityConverter}}">

            <Rectangle Fill="{DynamicResource OverlayBrush}"/>

            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="40,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="220">

                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Height="4" Width="160"
                                 Margin="0,0,0,16"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                    <TextBlock Text="Loading Customers...."
                               HorizontalAlignment="Center"
                               Style="{StaticResource TextMuted}"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
