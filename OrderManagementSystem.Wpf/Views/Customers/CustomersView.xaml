<UserControl x:Class="OrderManagementSystem.Wpf.Views.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Views.Customers"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             xmlns:components="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}"
             Loaded="CustomersView_Loaded">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Auto Size -->
            <RowDefinition Height="Auto"/> <!-- Auto Size -->
            <RowDefinition Height="*"/> <!-- Star Size -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Customers"
                       Style="{StaticResource TextHeading1}"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Manage your customer database and search through their records efficiently."
                       Style="{StaticResource TextMuted}"
                       Margin="0,5,0,0"/>

            <Border Background="#FEE2E2" CornerRadius="6" Margin="0,15,0,0" Padding="15,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Star Size -->
                <ColumnDefinition Width="Auto"/> <!-- Auto Size -->
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Add New Customer"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource SuccessButtonStyle}"
                        Padding="15,0" Margin="0,0,12,0"/>
                <Button Content="Refresh"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="100" Margin="0,0,12,0"/>
                <!-- Delete All Customers-->
                <Button Command="{Binding DeleteAllCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="130">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Delete All"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <ComboBox Width="150" Margin="0,0,12,0"
                          ItemsSource="{Binding SearchTypes}"
                          SelectedItem="{Binding SelectedSearchType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='Search by {0}'}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Width="280">
                    <TextBox Tag="Type To Search....."
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,0,35,0"/>
                    <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Margin="0,0,12,0" IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </StackPanel>
            
        </Grid>


        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
            <Grid>
                <DataGrid ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      Style="{StaticResource ModernDataGridStyle}"
                      HorizontalAlignment="Stretch"
                      AutoGenerateColumns="False"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      RowHeight="65"
                      GridLinesVisibility="None"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      RowDetailsVisibilityMode="VisibleWhenSelected">

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F1F5F9" 
                                    Padding="20" BorderThickness="0,1" 
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="All Contact Numbers" 
                                               FontWeight="Bold" 
                                               Margin="0,0,0,10" 
                                               Foreground="#475569"/>
                                    <ItemsControl ItemsSource="{Binding CustomerPhones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <Border Background="#E2E8F0" 
                                                            Padding="8,4" CornerRadius="4">
                                                        <TextBlock Text="{Binding PhoneType}" 
                                                                   FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding PhoneNumber}" 
                                                               Margin="10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="(Primary)" Foreground="#0284C7" FontSize="11" 
                                                               Visibility="{Binding IsPrimary, 
                                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    
                    <DataGrid.Columns>
                        <!-- Customer Info -> CustomerName + Email Column -->
                        <DataGridTemplateColumn Header="Customer Info"
                                            Width="2*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding CustomerName}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Email}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Phone Contact -> PhoneNumber Column  -->
                        <DataGridTemplateColumn Header="Phone Contact" Width="1.5*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding CustomerPhones}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,8,2">
                                                    <TextBlock Text="📞" FontSize="12"
                                                               Margin="0,0,4,0" 
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock 
                                                        Text="{Binding PhoneNumber}" 
                                                        VerticalAlignment="Center" 
                                                        Style="{StaticResource TextMuted}"/>
                                                    <TextBlock 
                                                        Text=" •" 
                                                        VerticalAlignment="Center" 
                                                        Foreground="#CBD5E1"
                                                        Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        

                        <!-- Location Address -> Address Column  -->
                        <DataGridTemplateColumn Header="Location Address"
                                            Width="1.5*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Address}"
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Style="{StaticResource TextBody}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column For Delete And Update Customers -->
                        <DataGridTemplateColumn Header="Actions" Width="1.5*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Edit -->
                                        <Button Command="{Binding DataContext.EditCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Padding="8,2" Margin="0,0,5,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✏️" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Edit" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Delete Current Row Only -->
                                        <Button 
                                            Command="{Binding DataContext.DeleteCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="8,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Delete" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                    </DataGrid.Columns>
                </DataGrid>

                <components:LoadingOverlayComponent Visibility="{Binding IsLoading,
                                                     Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
            
        </Border>

    </Grid>
    
</UserControl>
