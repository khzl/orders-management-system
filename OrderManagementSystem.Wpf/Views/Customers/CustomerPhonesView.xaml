<UserControl x:Class="OrderManagementSystem.Wpf.Views.Customers.CustomerPhonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Views.Customers"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NumericToVisibilityConverter x:Key="NumericToVisibilityConverter"/>
    </UserControl.Resources>

    <!--
        Root Grid — two layers:
          [0] All content (scrollable)
          [1] Full-screen loading overlay (Panel.ZIndex keeps it on top)
    -->
    <Grid>
        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ──────────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center">
                    
                    <Button Command="{Binding BackCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Width="45" Height="45" 
                            Padding="0" Margin="0,0,15,0"
                            ToolTip="Back To Customers List">
                        <TextBlock Text="⬅" FontSize="18" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Button>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Phone Contacts Management" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Customer: " 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CustomerName}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── Two-column body ─────────────────────────────────────── -->
            <Grid Grid.Row="1" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left card: phone list ─────────────────────────────── -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardStyle}" 
                        Padding="20" Margin="0,0,15,0" 
                        VerticalAlignment="Stretch">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Loading bar (inside left card, for data-load state) -->
                        <ProgressBar Grid.Row="0"
                                     IsIndeterminate="True" 
                                     Height="3"
                                     Margin="0,0,0,8"
                                     Background="Transparent" 
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Error banner: uses semantic StaticResources, not hardcoded hex -->
                        <Border Grid.Row="1"
                                Background="{StaticResource DangerBackgroundBrush}"
                                CornerRadius="6"
                                Padding="15,10"
                                Margin="0,0,0,15"
                                BorderThickness="1"
                                BorderBrush="{StaticResource DangerBorderBrush}"
                                Visibility="{Binding ErrorMessage,
                                Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerTextBrush}"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Empty state (shown when count = 0) -->
                        <StackPanel Grid.Row="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding CustomerPhones.Count,
                                    Converter={StaticResource NumericToVisibilityConverter},
                                    ConverterParameter=Empty}">
                            <TextBlock Text="📱"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Opacity="0.4"/>
                            <TextBlock Text="No phone records for this customer."
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Use the form on the right to add one."
                                       FontSize="13"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Phone list DataGrid (shown when count > 0) -->
                        <DataGrid Grid.Row="2" 
                                  ItemsSource="{Binding CustomerPhones}"
                                  SelectedItem="{Binding SelectedPhone, Mode=TwoWay}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  RowHeight="50"
                                  HeadersVisibility="Column"
                                  Visibility="{Binding CustomerPhones.Count,
                                  Converter={StaticResource NumericToVisibilityConverter}}">

                            <DataGrid.Columns>
                                <!-- Phone number -->
                                <DataGridTemplateColumn Header="Phone Number" Width="2*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" 
                                                        VerticalAlignment="Center"
                                                        Margin="10,0">
                                                <TextBlock 
                                                    Text="📞" 
                                                    Margin="0,0,8,0" 
                                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PhoneNumber}" 
                                                           FontSize="14" 
                                                           FontWeight="Medium" 
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Type -->
                                <DataGridTemplateColumn Header="Type" Width="1*" MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PhoneType}" 
                                                       FontSize="14" 
                                                       VerticalAlignment="Center" 
                                                       Margin="10,0" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--
                                    Status column — was broken:
                                    BoolToVisibilityConverter cannot produce background colors;
                                    ConverterParameter='LightGreen_Or_Transparent_Logic' was a no-op.
                                    Fixed with DataTrigger styles on Border and TextBlock.
                                -->
                                <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" 
                                                                Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimary}" 
                                                                         Value="True">
                                                                <Setter Property="Background" 
                                                                        Value="#D1FAE5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock VerticalAlignment="Center" 
                                                           FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"       
                                                                    Value="Standard"/>
                                                            <Setter Property="Foreground" 
                                                                    Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrimary}"
                                                                             Value="True">
                                                                    <Setter Property="Text"       
                                                                            Value="Primary ★"/>
                                                                    <Setter Property="Foreground" 
                                                                            Value="#065F46"/>
                                                                    <Setter Property="FontWeight" 
                                                                            Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete action -->
                                <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemovePhoneCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}" 
                                                    Width="36" Height="36" 
                                                    Margin="8,0"
                                                    BorderThickness="0"
                                                    ToolTip="Delete Phone Number">
                                                <TextBlock Text="🗑️" 
                                                           FontSize="13" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right card: form ───────────────────────────────────── -->
                <Border Grid.Column="1" 
                        Style="{StaticResource CardStyle}"
                        Padding="25" 
                        Margin="15,0,0,0" 
                        VerticalAlignment="Top">
                    <StackPanel IsEnabled="{Binding IsLoading,
                                Converter={StaticResource InverseBoolConverter}}">
                        <!--
                            Dynamic title: "Add New Phone" vs "Edit Phone Record"
                            Driven by IsEditMode / FormTitle in the ViewModel.
                        -->
                        <TextBlock Text="{Binding FormTitle}" 
                               FontSize="18" FontWeight="Bold" 
                               Margin="0,0,0,20"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                        <!-- Phone number field -->
                        <TextBlock Text="Phone Number" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,6" 
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                        
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="📞" 
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Center" 
                                   Margin="12,0,0,0" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   Panel.ZIndex="5"/>
                            
                            <TextBox Text="{Binding PhoneNumber,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Padding="35,10,10,10" 
                                     FontSize="14" 
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- Phone type -->
                        <TextBlock Text="Phone Type" 
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        
                        <ComboBox SelectedValue="{Binding PhoneType, Mode=TwoWay}"
                                  SelectedValuePath="Content" 
                                  Height="42" 
                                  Margin="0,0,0,20" 
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Mobile"/>
                            <ComboBoxItem Content="Work"/>
                            <ComboBoxItem Content="Home"/>
                        </ComboBox>

                        <!-- Primary toggle -->
                        <Border BorderThickness="0,0,0,1" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                Padding="0,0,0,20" 
                                Margin="0,0,0,20">
                            <CheckBox IsChecked="{Binding IsPrimary, Mode=TwoWay}"
                                      Content="Mark as Primary Contact Number ⭐" 
                                      Style="{StaticResource ModernToggleSwitch}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <!-- Action buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Content="Apply to List" 
                                    Command="{Binding SavePhoneCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="40" 
                                    FontWeight="SemiBold"
                                    Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1" 
                                    Content="Clear" 
                                    Command="{Binding ClearFormCommand}" 
                                    Style="{StaticResource OutlineButtonStyle}" 
                                    Height="40" 
                                    Padding="18,0" 
                                    FontWeight="Medium"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Bottom action bar ───────────────────────────────────── -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                
                <Button Content="Cancel" 
                        Command="{Binding BackCommand}" 
                        Style="{StaticResource OutlineButtonStyle}" 
                        Padding="24,12" 
                        Margin="0,0,12,0" 
                        Width="120"/>
                
                <Button Content="Save Phone Records" 
                        Command="{Binding SaveChangesCommand}" 
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Padding="24,12"
                        Width="200" 
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             Layer 1 – full-view loading overlay
             Covers everything during SaveAllChanges to block accidental clicks.
        ═══════════════════════════════════════════════════════════════════ -->

        <Grid Panel.ZIndex="100"
              Visibility="{Binding IsLoading,
                           Converter={StaticResource BoolToVisibilityConverter}}">

            <Rectangle Fill="#80000000"/>

            <Border Background="{StaticResource BackgroundBrush}"
                    CornerRadius="12"
                    Padding="36,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="220">
                
                <StackPanel HorizontalAlignment="Center">
                    
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Width="160"
                                 Margin="0,0,0,16"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                    
                    <TextBlock Text="Please wait…"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TextMuted}"
                               FontSize="14"/>
                    
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
