<UserControl x:Class="OrderManagementSystem.Wpf.Views.Customers.AddCustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Views.Customers"
             xmlns:converters="clr-namespace:OrderManagementSystem.Wpf.Converters"
             xmlns:components="clr-namespace:OrderManagementSystem.Wpf.Components"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <!--
        Root Grid: two layers
          [0] Scrollable content
          [1] Loading overlay  (Panel.ZIndex keeps it on top)
    -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             Layer 0 – main content
        ═══════════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40">
                <StackPanel>

                    <!-- ── Header ──────────────────────────────────────── -->
                    <StackPanel Margin="0,0,0,30">
                        
                        <Button Command="{Binding CancelCommand}"
                                Style="{StaticResource BackButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" 
                                       FontSize="16" 
                                       Margin="0,0,6,0" 
                                       VerticalAlignment="Center"/>
                                <TextBlock 
                                Text="Back to Customers List" 
                                Style="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock 
                        Text="Create New Customer" Style="{StaticResource TextHeading1}" Margin="0,0,0,5"/>
                        <TextBlock 
                        Text="Complete the information below to register a new customer in the system." 
                        Style="{StaticResource TextMuted}"/>
                    </StackPanel>

                    <!-- ── Card ────────────────────────────────────────── -->
                    <Border Style="{StaticResource CardStyle}" 
                        MaxWidth="1400" 
                        HorizontalAlignment="Stretch" 
                        Margin="0,0,20,0"
                        Padding="30">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Form component -->
                            <components:CustomerFormComponent 
                                Grid.Row="0" 
                                Margin="11,0,0,30"
                                CustomerName="{Binding CustomerName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                Email="{Binding Email,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                Address="{Binding Address,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                ErrorMessage="{Binding ErrorMessage}"
                                IsLoading="{Binding IsLoading}"
                                CustomerPhones="{Binding CustomerPhones}"
                                AddPhoneCommand="{Binding AddPhoneCommand}"
                                RemovePhoneCommand="{Binding RemovePhoneCommand}"
                                UpdatePhoneCommand="{Binding UpdatePhoneCommand}"
                                SetPrimaryCommand="{Binding SetPrimaryCommand}"/>

                            <!-- Action bar -->
                            <Border Grid.Row="1" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="0,1,0,0" 
                                    Padding="0,25,0,0">
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    
                                    <Button Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Width="120" Height="45" 
                                            Margin="0,0,15,0"/>
                                    
                                    <Button Content="Save Customer"
                                            Command="{Binding SaveCommand}"
                                            IsEnabled="{Binding IsLoading,
                                            Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="180" Height="45"/>
                                    
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════════
             Layer 1 – loading overlay
             Sits over the entire view; blocks all interaction while saving.
        ═══════════════════════════════════════════════════════════════ -->

        <Grid Panel.ZIndex="100"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            
            <!-- Dimmed backdrop -->
            <Rectangle Fill="#80000000"/>
            
            <!-- Centred spinner card -->
            <Border Background="{StaticResource BackgroundBrush}"
                    CornerRadius="12"
                    Padding="36,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="220">

                <StackPanel HorizontalAlignment="Center">

                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Width="160"
                                 Margin="0,0,0,16"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"/>

                    <TextBlock Text="Saving Customer....."
                               HorizontalAlignment="Center"
                               Style="{StaticResource TextMuted}"
                               FontSize="14"/>
                    
                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
