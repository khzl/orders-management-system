<UserControl x:Class="OrderManagementSystem.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderManagementSystem.Wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,24">
            <TextBlock 
                   Text="System Settings"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1A1A1A"/>
            <TextBlock Text="Configure and customize your Order Management System application preferences."
                       FontSize="13"
                       Foreground="#7A7A7A"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Stretch">

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000"
                                          BlurRadius="15"
                                          ShadowDepth="2"
                                          Opacity="0.03"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Appearance &amp; Localization"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Language:"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableLanguages}" 
                                      SelectedItem="{Binding SelectedLanguage}" 
                                      Width="220" 
                                      HorizontalAlignment="Left" 
                                      Padding="8,6"/>
                        </Grid>

                        <CheckBox 
                            Content="Enable Dark Mode Custom Theme" 
                            IsChecked="{Binding IsDarkMode}" 
                            Style="{StaticResource ModernCheckBoxStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" 
                                          BlurRadius="15" 
                                          ShadowDepth="2" 
                                          Opacity="0.03"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Application Connectivity" 
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <CheckBox
                            Content="Enable real-Time Push Notifications" 
                            IsChecked="{Binding EnableNotifications}" 
                            Style="{StaticResource ModernCheckBoxStyle}"
                            Margin="0,0,0,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock 
                                Text="API Base URL:" 
                                Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox 
                                Grid.Column="1" 
                                Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                Padding="8,6"/>
                        </Grid>
                    </StackPanel>
                </Border>


                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect 
                            Color="#000" 
                            BlurRadius="15" 
                            ShadowDepth="2" 
                            Opacity="0.03"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock 
                            Text="Business Defaults"
                            Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock 
                                Text="Default Tax Rate (%):" 
                                Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox 
                                Grid.Column="1" 
                                Text="{Binding DefaultTaxRate, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                Width="200" 
                                HorizontalAlignment="Left" 
                                Padding="8,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="#EAEAEA"
                Padding="0,16,0,0"
                Margin="0,16,0,0">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                     Grid.Column="0" 
                     Text="{Binding StatusMessage}" 
                     Foreground="#2E7D32"
                     VerticalAlignment="Center" 
                     FontWeight="SemiBold"
                     FontSize="13"/>

                <Button 
                    Grid.Column="1" 
                    Command="{Binding ResetCommand}"
                    Content="Reset to Defaults" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="180"
                    Height="40"
                    Margin="0,0,12,0"/>
                
                <Button
                    Grid.Column="2" 
                    Command="{Binding SaveCommand}" 
                    Content="Save Settings" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="140"
                    Height="40"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
